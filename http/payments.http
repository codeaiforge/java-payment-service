# Manual API calls, grown episode by episode.
# Run with IntelliJ HTTP Client or the VS Code "REST Client" extension
# against a running app: ./mvnw spring-boot:run, or since Episode 19 docker compose --profile app up --build
#
# Since Episode 10 every POST /payments needs an Idempotency-Key. Re-running a request
# with the same key returns the payment it created the first time; change the key
# to create a new one.

#
# Since Bonus 01 every /payments request needs a bearer token. These are signed with the local key
# (application-local.properties) and never expire: local use only. CUST-1001 holds ACC-10001 and ACC-20001;
# CUST-2002 holds ACC-30001 (wiremock/mappings/accounts.json).

@baseUrl = http://localhost:8080
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJDVVNULTEwMDEifQ.dBtBctssK74kMTXqNo4zPSkk--7cSdouBA4q40hCBb8
@otherToken = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJDVVNULTIwMDIifQ.ZJZiegB_bFlLacCyV-BTegv-ZFEG4R4JdS0knsWwV60

### Episode 01 — create payment -> 201
POST {{baseUrl}}/payments
Authorization: Bearer {{token}}
Idempotency-Key: episode-01-request-1
Content-Type: application/json

{
  "sourceAccountId": "ACC-10001",
  "destinationAccountId": "ACC-20001",
  "amount": 250.00,
  "currency": "EUR",
  "reference": "Invoice 12345"
}

